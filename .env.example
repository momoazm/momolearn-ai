# Local development only. On Vercel these are IGNORED for visitors -
# the deployed sites require each user's own key (see /keys.html).
PORT=3000
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
GITHUB_TOKEN=
OPENAI_API_KEY=
MBZUAI_ACCESS_CODE=
MBZUAI_ACCESS_CODE=change-me
MBZUAI_DAILY_LIMIT=15
# Year2 cloud save (momomath-year2 cross-device Google sync). Must equal the
# frontend's VITE_GOOGLE_CLIENT_ID. Set it on Vercel too — without it the
# /api/year2/session + /api/year2/cloudsave endpoints refuse auth (fail-closed).
YEAR2_GOOGLE_CLIENT_ID=
# Year2 first-party sessions (HMAC-SHA256, 90 days). Random 32+ bytes, Vercel
# + local .env.local only — never ship to the browser. Without it no session
# can be minted or verified (fail-closed).
YEAR2_SESSION_SECRET=
